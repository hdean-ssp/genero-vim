" tests/vimrc — minimal Neovim config for vader.vim test execution
"
" This file is passed to nvim via -u tests/vimrc when running VimScript tests.
" It sets up the minimum runtimepath needed for vader.vim and the plugin under
" test, then sources the shared test helper files.
"
" Neovim only — plain Vim is not supported by this test suite.

set nocompatible

" ── Plugin root (the repo itself) ─────────────────────────────────────────────
" Adds autoload/, plugin/, ftdetect/, etc. to runtimepath so the plugin loads.
set runtimepath+=.

" ── vader.vim ─────────────────────────────────────────────────────────────────
" Support common installation locations. The first one found wins.
" Users can override by setting $VADER_PATH before running the runner.
if !empty($VADER_PATH)
  execute 'set runtimepath+=' . $VADER_PATH
elseif isdirectory(expand('~/.vim/plugged/vader.vim'))
  set runtimepath+=~/.vim/plugged/vader.vim
elseif isdirectory(expand('~/.local/share/nvim/lazy/vader.vim'))
  set runtimepath+=~/.local/share/nvim/lazy/vader.vim
elseif isdirectory(expand('~/.local/share/nvim/site/pack/test/start/vader.vim'))
  set runtimepath+=~/.local/share/nvim/site/pack/test/start/vader.vim
elseif isdirectory(expand('~/.config/nvim/plugged/vader.vim'))
  set runtimepath+=~/.config/nvim/plugged/vader.vim
else
  echoerr 'vader.vim not found. Set $VADER_PATH or install vader.vim.'
  cquit 1
endif

" ── Enable filetype detection and syntax highlighting ─────────────────────────
filetype plugin indent on
syntax on

" ── Load test helper modules ──────────────────────────────────────────────────
" These provide TestSetup(), TestTeardown(), assertion helpers, and generators.
" Source them only if they exist (they are created in task 4).
for s:helper in [
  \ 'tests/helpers/setup.vim',
  \ 'tests/helpers/assertions.vim',
  \ 'tests/helpers/mock_config.vim',
  \ 'tests/helpers/generators.vim',
  \ ]
  if filereadable(s:helper)
    execute 'source ' . s:helper
  endif
endfor
unlet s:helper
